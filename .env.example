# Firebase (client) — https://console.firebase.google.com
NUXT_PUBLIC_FIREBASE_API_KEY=RENSEIGNE_TA_CLE_ICI
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=RENSEIGNE_TON_DOMAINE_ICI
NUXT_PUBLIC_FIREBASE_PROJECT_ID=RENSEIGNE_TON_PROJECT_ID_ICI
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=RENSEIGNE_TON_BUCKET_ICI
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=RENSEIGNE_TON_SENDER_ID_ICI
NUXT_PUBLIC_FIREBASE_APP_ID=RENSEIGNE_TON_APP_ID_ICI

# API externe (eglise-app)
PUBLIC_API_URL=https://eglise-app.belletonv.workers.dev

# Firebase Admin (SSR — service account)
NUXT_FIREBASE_PROJECT_ID=RENSEIGNE_LE_PROJECT_ID_ICI
NUXT_FIREBASE_CLIENT_EMAIL=RENSEIGNE_L_EMAIL_ICI
NUXT_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
RENSEIGNE_LA_CLE_ICI
-----END PRIVATE KEY-----"

# Mailjet — envoi d'emails via l'API HTTP (PAS de SMTP : voir server/utils/send-email.ts)
# Clé/secret : https://app.mailjet.com/account/apikeys
# FROM_EMAIL doit être une adresse validée dans Mailjet (Senders & Domains),
# sinon Mailjet accepte la requête mais rejette le message.
NUXT_MAILJET_API_KEY=RENSEIGNE_TA_CLE_ICI
NUXT_MAILJET_API_SECRET=RENSEIGNE_TON_SECRET_ICI
NUXT_MAILJET_FROM_EMAIL=adresse-validee@exemple.com
NUXT_MAILJET_FROM_NAME=Église Cieux Ouverts
