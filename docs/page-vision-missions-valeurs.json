        {
            "id": "8e010359-034d-4704-ad3f-7965069c17b5",
            "type": "richText",
            "props": {
                "content": "<style>\n.vmv-valeurs{max-width:900px;margin:0 auto;font-family:'Nunito',sans-serif;color:#FFFFFF}\n.vmv-valeurs h2{color:#FFFFFF;text-align:center;text-transform:uppercase;letter-spacing:0.06em;font-size:2em;margin:0 0 12px}\n.vmv-valeurs .vmv-sep{width:56px;height:4px;background:#C62828;border-radius:2px;margin:0 auto 36px}\n.vmv-vgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;text-align:center}\n.vmv-val{padding:18px 8px}\n.vmv-val svg{width:34px;height:34px;stroke:#FFFFFF;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;margin-bottom:10px}\n.vmv-val span{display:block;font-size:1.05em;letter-spacing:0.08em;text-transform:uppercase}\n@media (max-width:700px){.vmv-vgrid{grid-template-columns:repeat(2,1fr)}}\n</style>\n<div class=\"vmv-valeurs\">\n<h2>Nos valeurs</h2>\n<div class=\"vmv-sep\"></div>\n<div class=\"vmv-vgrid\">\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 11l9-7 9 7M5 10v9h5v-5h4v5h5v-9\"/></svg><span>Accueil</span></div>\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><circle cx=\"8\" cy=\"9\" r=\"3\"/><circle cx=\"16\" cy=\"9\" r=\"3\"/><path d=\"M2.5 19c0-2.5 2.5-4.5 5.5-4.5S13.5 16.5 13.5 19M10.5 19c0-2.5 2.5-4.5 5.5-4.5s5.5 2 5.5 4.5\"/></svg><span>Unit\u00e9</span></div>\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z\"/></svg><span>Honneur</span></div>\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 21s-6-4.3-6-9.5C6 8.5 8 7 10 7c.9 0 1.6.4 2 1 .4-.6 1.1-1 2-1 2 0 4 1.5 4 4.5 0 5.2-6 9.5-6 9.5z\"/></svg><span>Humilit\u00e9</span></div>\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3v4M12 7c-3 2-5 4-5 7a5 5 0 0 0 10 0c0-3-2-5-5-7zM8 21h8\"/></svg><span>Adoration</span></div>\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"5\"/><path d=\"M9 12.5L7 21l5-2.5L17 21l-2-8.5\"/></svg><span>Excellence</span></div>\n<div class=\"vmv-val\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 5.5A2.5 2.5 0 0 1 6.5 3H12v18H6.5A2.5 2.5 0 0 0 4 23.5zM12 3h5.5A2.5 2.5 0 0 1 20 5.5v15a2.5 2.5 0 0 0-2.5-2.5H12z\"/></svg><span>T\u00e9moignage</span></div>\n</div></div>",
