            "type": "richText",
            "props": {
                "content": "<style>\n.vmv-missions{max-width:1000px;margin:0 auto;font-family:'Inter','Montserrat',sans-serif;padding:0 16px}\n.vmv-missions h2{font-family:'Inter','Montserrat',sans-serif;font-style:normal;color:#1A4C8B;text-align:center;text-transform:uppercase;letter-spacing:0.08em;font-size:1.9em;font-weight:800;margin:0 0 48px}\n.vmv-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}\n.vmv-card{background:#F2F2F2;border-radius:16px;padding:32px 28px;text-align:center;box-shadow:0 2px 12px rgba(0,0,0,0.08);transition:transform .2s ease}\n.vmv-card:hover{transform:scale(1.02)}\n.vmv-icon-wrap{width:72px;height:72px;border-radius:50%;background:#1A4C8B;display:flex;align-items:center;justify-content:center;margin:0 auto 22px}\n.vmv-icon-wrap svg{width:43px;height:43px}\n.vmv-card h3{font-family:'Inter','Montserrat',sans-serif;font-style:normal;color:#1A4C8B;text-transform:uppercase;font-size:1.05em;font-weight:800;letter-spacing:0.02em;margin:0;line-height:1.4}\n@media (max-width:700px){.vmv-grid{grid-template-columns:1fr}}\n</style>\n<div class=\"vmv-missions\">\n<h2>Nos missions</h2>\n<div class=\"vmv-grid\">\n\n<div class=\"vmv-card\">\n  <div class=\"vmv-icon-wrap\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M12 11.2c-1.2-1.5-3.3-1.6-4.4-.3-1.1 1.3-.9 3.1.4 4.4L12 19l3.9-3.7c1.3-1.3 1.5-3.1.4-4.4-1.1-1.3-3.2-1.2-4.3.3z\"/>\n      <path d=\"M3.5 14.5c0 2.7 1.7 4.7 3.6 5M20.5 14.5c0 2.7-1.7 4.7-3.6 5\"/>\n    </svg>\n  </div>\n  <h3>Accueillir et vivre l'unit\u00e9</h3>\n</div>\n\n<div class=\"vmv-card\">\n  <div class=\"vmv-icon-wrap\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M12 3v18M7.5 8.5h9\"/>\n    </svg>\n  </div>\n  <h3>C\u00e9l\u00e9brer et cultiver la pr\u00e9sence de Dieu</h3>\n</div>\n\n<div class=\"vmv-card\">\n  <div class=\"vmv-icon-wrap\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M12 6.3c-1-1.2-2.7-1.3-3.6-.2-.9 1.1-.7 2.5.3 3.5L12 13l3.3-3.4c1-1 1.2-2.4.3-3.5-.9-1.1-2.6-1-3.6.2z\"/>\n      <path d=\"M5 14.5c0 3.3 3.1 6 7 6s7-2.7 7-6\"/>\n    </svg>\n  </div>\n  <h3>Accompagner et restaurer les vies</h3>\n</div>\n\n<div class=\"vmv-card\">\n  <div class=\"vmv-icon-wrap\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <circle cx=\"7\" cy=\"8\" r=\"2.3\"/>\n      <path d=\"M2.6 18c0-2.8 2-4.8 4.4-4.8s4.4 2 4.4 4.8\"/>\n      <circle cx=\"16.5\" cy=\"7\" r=\"2\"/>\n      <path d=\"M21 15.2c0-2.1-1.7-3.7-3.9-3.7-.5 0-1 .1-1.5.3\"/>\n      <path d=\"M15.3 15.2h4.4a2 2 0 0 1 2 2v1.1l1.3 1.5-2.1-.4h-5.6a2 2 0 0 1-2-2v-.2a2 2 0 0 1 2-2z\"/>\n    </svg>\n  </div>\n  <h3>T\u00e9moigner et former des disciples</h3>\n</div>\n\n</div>\n</div>\n",
