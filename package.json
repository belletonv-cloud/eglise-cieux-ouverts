{
  "name": "eglise-cieux-ouverts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "engineStrict": false,
  "scripts": {
    "preinstall": "node -e \"if (!/^22\\\\./.test(process.versions.node)) { console.error('❌ Node 22.x.x requis. Utilisez nvm, volta, ou nodenv.'); process.exit(1); }\"",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:e2e": "PW_TEST=1 nuxt build",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:quick": "playwright test",
    "test:admin": "playwright test --config=playwright.admin.config.ts",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "preview": "nuxt preview",
    "preview:local": "PW_TEST=1 NITRO_PORT=3001 NITRO_HOST=0.0.0.0 node .output/server/index.mjs",
    "dev:server": "node .output/server/index.mjs",
    "deploy": "nuxt build && wrangler pages deploy dist --project-name eglise-cieux-ouverts"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "dompurify": "^3.4.10",
    "firebase": "^12.12.1",
    "isomorphic-dompurify": "^3.17.0",
    "nuxt": "3.20.0",
    "pinia": "^3.0.4",
    "swiper": "^12.2.0",
    "vue": "^3.4.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.0",
    "playwright": "^1.35.0",
    "wrangler": "^4.94.0"
  },
  "volta": {
    "node": "22.22.3"
  }
}
