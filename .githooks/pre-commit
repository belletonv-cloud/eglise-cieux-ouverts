#!/usr/bin/env bash
#
# Refuse un commit qui introduirait un secret.
#
# Délègue à scripts/scan-secrets.sh plutôt que de redéfinir ses motifs : la
# version précédente en tenait une copie, forcément dérivante, et exigeait
# `rg` alors que le scanner se contente de `grep`. Un seul endroit décide
# désormais de ce qui est bloquant.
#
# Installation (une fois par clone) :
#   git config core.hooksPath .githooks

set -uo pipefail

RACINE=$(git rev-parse --show-toplevel)
exec bash "$RACINE/scripts/scan-secrets.sh" --staged
